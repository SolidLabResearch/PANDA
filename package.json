{
    "name": "privacy-preserved-healthcare-stream-monitoring",
    "version": "1.0.0",
    "description": "A privacy preserved healthcare stream monitoring from Solid Pod(s) for anomaly detection",
    "main": "dist/index.js",
    "engines": {
        "node": ">=22 <25"
    },
    "scripts": {
        "build": "npx tsc",
        "start": "npx tsc && cp -r ./src/static ./dist && node --max-old-space-size=8192 dist/index.js ",
        "start-monitoring": "npx tsc && cp -r ./src/static ./dist && node --max-old-space-size=8192 dist/index.js monitoring",
        "smoke:uma": "node scripts/uma/smoke.js",
        "start-log": "npx tsc && cp -r ./src/static ./dist && node --max-old-space-size=8192 dist/index.js monitoring > logs/output.log",
        "docs": "esdoc",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "start-solid-server": "cd scripts && rm -rf data/.internal/accounts && npx community-solid-server --config ./pod/config/unsafe.json  -f ./data/ --seededPodConfigJson ./pod/pod_credentials.json -w 0",
        "restart-solid-server": "cd scripts && npx community-solid-server --config ./pod/config/unsafe.json -f ./data/ -w 0",
        "start-solid-server-extended-lock": "cd scripts && rm -rf data/.internal/ && npx community-solid-server --config ./pod/config/extendedlock.json -f ./data/ --seededPodConfigJson ./pod/pod_credentials.json",
        "test-run": "cd scripts && rm -rf data/.internal/ && npx community-solid-server --config ./pod/config/auth.json -f ./data/ --seededPodConfigJson ./pod/pod_credentials.json --workers 1",
        "benchmark:uma-odrl": "node scripts/benchmark/uma_odrl_flow_benchmark.js",
        "benchmark:protected-alert-access": "node scripts/benchmark/protected_alert_access_benchmark.js",
        "benchmark:protected-alert-access:validate": "node scripts/benchmark/validate_protected_alert_access_results.js",
        "benchmark:protected-alert-lifecycle": "node scripts/benchmark/protected_alert_lifecycle_benchmark.js",
        "benchmark:protected-alert-lifecycle:validate": "node scripts/benchmark/validate_protected_alert_lifecycle_results.js",
        "benchmark:live-registration": "node scripts/benchmark/benchmark_live_registration.js",
        "benchmark:live-registration:with-replayer": "node scripts/benchmark/run_live_registration_with_replayer.js",
        "benchmark:uma-odrl:matrix": "node scripts/benchmark/run_uma_odrl_latency_matrix.js",
        "benchmark:unified-sanity": "node scripts/benchmark/unified_panda_uma_sanity_harness.js",
        "lint:ts": "npx eslint . --report-unused-disable-directives --max-warnings 0",
        "lint:ts:fix": "npx eslint . --ext ts --report-unused-disable-directives --max-warnings 0 --fix",
        "lint:no-warning": "eslint . --ext ts --quiet --max-warnings 0",
        "benchmark:uma-odrl:strict": "node scripts/benchmark/run_strict_uma_odrl_replayer_benchmarks.js",
        "uma:start:odrl:logged": "bash scripts/uma/start_odrl_logged.sh",
        "uma:check-derived": "node scripts/uma/check-derived-registration.js",
        "uma:preflight": "node scripts/uma/preflight-derived.js"
    },
    "keywords": [],
    "author": "Kushagra Singh Bisen",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@types/bunyan": "^1.8.11",
        "@types/jest": "^29.5.12",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node-fetch": "^2.6.12",
        "@types/pidusage": "^2.0.5",
        "@types/websocket": "^1.0.6",
        "@typescript-eslint/parser": "^6.21.0",
        "esdoc": "^1.1.0",
        "eslint": "^8.57.1",
        "eslint-plugin-jest": "^27.8.0",
        "eslint-plugin-jsdoc": "^48.0.6",
        "globals": "^15.14.0",
        "jest": "^29.3.1",
        "ts-jest": "^29.0.3",
        "typescript": "^4.9.4",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@treecg/ldes-snapshot": "^0.1.1",
        "@treecg/versionawareldesinldp": "^0.3.0",
        "@types/axios": "^0.14.0",
        "bunyan": "^1.8.15",
        "css-auth-login": "^1.0.8",
        "dotenv": "^16.4.7",
        "eyeling": "^1.22.16",
        "jsonld": "^8.3.2",
        "jsonwebtoken": "^9.0.2",
        "nock": "^14.0.1",
        "pidusage": "^3.0.2",
        "rate-limited-ldp-communication": "^1.0.5",
        "rdflib": "^2.2.31",
        "rsp-js": "file:../RSP-JS",
        "rspql-query-equivalence": "^1.0.3",
        "sparqljs": "^3.6.2",
        "tslog": "^4.8.2",
        "websocket": "^1.0.34"
    }
}
